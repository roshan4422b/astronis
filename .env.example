# Public Cloudflare Turnstile site key; safe to expose in browser bundles.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only Cloudflare Turnstile secret key. Never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Server-only Mailtrap transactional email credentials.
MAILTRAP_API_KEY=your_mailtrap_api_token
MAILTRAP_FROM_EMAIL=no-reply@astronisglobal.com

# Server-only secure professional application intake endpoint and bearer token.
# The endpoint must be HTTPS and must store application documents privately.
PROFESSIONAL_APPLICATION_WEBHOOK_URL=
PROFESSIONAL_APPLICATION_WEBHOOK_TOKEN=
# Optional upload limit in bytes (defaults to 8 MiB; maximum 20 MiB).
PROFESSIONAL_APPLICATION_MAX_FILE_BYTES=8388608
# Set to true only when Astronis Global opens intern/trainee recruitment.
PROFESSIONAL_INTERN_RECRUITMENT_OPEN=false
